{
  "expo": {
    "name": "Pixel Lyrics",
    "slug": "pixel-lyrics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/pixel-lyrics-logo.png",
    "scheme": "pixel-lyrics",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Test1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Test1"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/pixel-lyrics-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F6F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
